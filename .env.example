# Application URL (used in automated welcome emails and portal links)
APP_URL="http://localhost:3000"
PORT="3000"

# Optional: Pre-configure initial Super Admin credentials.
# If left empty, /admin/login displays a secure one-time First-Run Super Admin Setup form.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Automated Email Service Configuration (configure ONE provider: Resend, SendGrid, or SMTP)
# Option 1: Resend API (Recommended)
RESEND_API_KEY=""

# Option 2: SendGrid API
SENDGRID_API_KEY=""

# Sender Display Name & Address (used by Resend, SendGrid, and SMTP)
EMAIL_FROM="Abhinav Institute of Technology & Management <aitm.connect@abhinavinst.com>"

# Option 3: SMTP Server
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Abhinav Institute of Technology & Management <aitm.connect@abhinavinst.com>"
